# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# COORDINATOR_ACCESS_CODE: Kod akses peribadi awal bagi Penyelaras Perkhemahan (lalai: 1234)
COORDINATOR_ACCESS_CODE="1234"

# SESSION_SECRET: Rahsia tandatangan sesi dan penyulitan kod akses guru pada pelayan
SESSION_SECRET="change-this-session-secret-in-production"

# DATA_DIR: Direktori storan pangkalan data SQLite dan muat naik gambar (lalai: ./data)
DATA_DIR="./data"
